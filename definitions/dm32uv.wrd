{
  "definition_type": "radio_read",
  "definition_version": 1,
  "id": "dm32uv",
  "notation": {
    "source": "Baofeng DM-32UV page-mapped serial protocol, based on QDMR dm32uv_interface.cc and DM32-Protocol-Spec hardware captures. Radio transfer remains untested in WaffleCPS.",
    "numbers": "Addresses, offsets, and lengths are bytes; 0x-prefixed values are hexadecimal."
  },
  "serial_transport": {
    "protocol": "paged_addressed_serial_v1",
    "vendor_id": "0x067B",
    "product_id": "0x23A3",
    "additional_usb_ids": [
      {"vendor_id": "0x1A86", "product_id": "0x7523"}
    ],
    "baud_rate": 115200,
    "timeout_ms": 5000,
    "open_delay_ms": 800,
    "close_reset_ms": 500,
    "identity_steps": [
      {
        "request_hex": "50 53 45 41 52 43 48",
        "response_prefix_hex": "06",
        "response_bytes": 8,
        "allowed_response_text": ["DP570", "DM32", "DM-32"],
        "pre_read_delay_ms": 150
      },
      {
        "request_hex": "50 41 53 53 53 54 41",
        "response_prefix_hex": "50",
        "response_bytes": 3,
        "pre_read_delay_ms": 50
      },
      {
        "request_hex": "53 59 53 49 4E 46 4F",
        "response_prefix_hex": "06",
        "response_bytes": 1,
        "pre_read_delay_ms": 50
      }
    ],
    "memory_query": {
      "request_hex": "56 00 00 00 0A",
      "response_prefix_hex": "56 0A",
      "payload_bytes": 8,
      "lower_offset": 0,
      "upper_offset": 4
    },
    "enter_program_steps": [
      {
        "request_hex": "FF FF FF FF 0C 50 52 4F 47 52 41 4D",
        "response_prefix_hex": "06",
        "response_bytes": 1,
        "pre_read_delay_ms": 10
      },
      {
        "request_hex": "02",
        "response_prefix_hex": "FF FF FF FF FF FF FF FF",
        "response_bytes": 8,
        "pre_read_delay_ms": 10
      },
      {
        "request_hex": "06",
        "response_prefix_hex": "06",
        "response_bytes": 1,
        "pre_read_delay_ms": 10
      }
    ],
    "page_map": {
      "page_bytes": 4096,
      "id_offset": 4095,
      "maximum_pages": 512,
      "probe_delay_ms": 5,
      "block_delay_ms": 150,
      "unallocated_write_address": "0xFFF001"
    },
    "read_packet": {
      "request_hex": "52",
      "response_hex": "57",
      "address_type": "u24le",
      "length_type": "u16le",
      "pre_read_delay_ms": 25,
      "payload_timeout_ms": 15000
    },
    "write_packet": {
      "request_hex": "57",
      "response_hex": "06",
      "address_type": "u24le",
      "length_type": "u16le",
      "pre_read_delay_ms": 25
    }
  },
  "methods": {
    "read_codeplug": {
      "assembly": {
        "operation": "replace_pages_by_id_in_template",
        "bytes": 659456,
        "representation": "oem_data"
      }
    },
    "write_codeplug": {
      "codeplug_definition_id": "dm32uv",
      "representation": "oem_data",
      "exclude_page_ids": [2],
      "verify_after_write": true
    }
  }
}
