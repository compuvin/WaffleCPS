if(NOT BUILD_NUMBER)
    find_program(GIT_EXECUTABLE git REQUIRED)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse HEAD
        OUTPUT_VARIABLE BUILD_NUMBER OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE git_result)
    if(NOT git_result EQUAL 0)
        message(FATAL_ERROR "Cannot determine build commit; set WAFFLE_BUILD_NUMBER explicitly")
    endif()
endif()
if(NOT BUILD_NUMBER MATCHES "^[0-9a-fA-F]+$")
    message(FATAL_ERROR "Build commit ID must be hexadecimal")
endif()
string(LENGTH "${BUILD_NUMBER}" commit_length)
if(commit_length LESS 8)
    message(FATAL_ERROR "Build commit ID must contain at least eight characters")
endif()
string(SUBSTRING "${BUILD_NUMBER}" 0 8 BUILD_NUMBER)
get_filename_component(output_directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
set(content "#pragma once\n#define WAFFLE_VERSION \"${APP_VERSION}\"\n#define WAFFLE_BUILD_NUMBER \"${BUILD_NUMBER}\"\n")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
    if(previous STREQUAL content)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${content}")
